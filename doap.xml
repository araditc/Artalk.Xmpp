  <Project xml:lang="en">
    <name>Artalk.Xmpp</name>
    <shortdesc xml:lang="en">A .NET 10 XMPP client library</shortdesc>
    <description xml:lang="en">Artalk.Xmpp is a .NET 10 library for connecting to XMPP servers, sending and receiving messages, managing presence and rosters, and using common XMPP extension protocols.</description>
    <homepage rdf:resource="https://github.com/araditc/Artalk.Xmpp"/>
    <schema:documentation rdf:resource="https://github.com/araditc/Artalk.Xmpp#readme"/>
    <download-page rdf:resource="https://www.nuget.org/packages/Artalk.Xmpp"/>
    <bug-database rdf:resource="https://github.com/araditc/Artalk.Xmpp/issues"/>
    <license rdf:resource="https://github.com/araditc/Artalk.Xmpp/blob/master/LICENSE"/>
    <programming-language>C#</programming-language>
    <os>.NET 10</os>
    <category rdf:resource="https://linkmauve.fr/ns/xmpp-doap#category-library"/>

    <repository>
      <GitRepository>
        <browse rdf:resource="https://github.com/araditc/Artalk.Xmpp"/>
        <location rdf:resource="https://github.com/araditc/Artalk.Xmpp.git"/>
      </GitRepository>
    </repository>

